{
  "name": "kumparan-web-playwright-agent",
  "version": "1.0.0",
  "description": "Playwright tests for kumparan.com desktop + mobile, planned/generated/healed with Playwright Test Agents (kumparan QA skill test, Task C).",
  "scripts": {
    "test": "playwright test",
    "test:desktop": "playwright test --project=desktop-chrome",
    "test:mobile": "playwright test --project=mobile-chrome",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
